#!/usr/bin/env python3
"""token-status: live plan-usage bars for Claude, Codex and Grok in a terminal pane.

Usage: token-status [claude|codex|grok|all] [interval_seconds]
       token-status --json [claude|codex|grok|all]     print once as JSON and exit

Reads each tool's own login on this machine:
  claude  ~/.claude/.credentials.json  -> api.anthropic.com/api/oauth/usage (what Claude Code's /usage reads)
  codex   `codex app-server`           -> account/rateLimits/read (what Codex's /status reads)
  grok    ~/.grok/auth.json            -> cli-chat-proxy.grok.com/v1/billing (what Grok's /usage reads)
None of these endpoints are documented public APIs; they can change without notice.

Pace: the bar's │ marks how much of the window has passed. Used left of it = under budget.
"""
import json, os, shutil, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")
DEFAULT_INTERVAL = {"claude": 300, "codex": 120, "grok": 120, "all": 300}
HOUR, DAY = 3600, 86400


# ---------- limits and pace ----------

def to_dt(ts):
    if ts is None:
        return None
    if isinstance(ts, str):
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    return datetime.fromtimestamp(ts, timezone.utc)


def limit(label, percent, resets_at, window_seconds):
    """One usage limit, with pace computed from how much of its window has passed."""
    pct = float(percent or 0)
    reset = to_dt(resets_at)
    now = datetime.now(timezone.utc)
    d = {"label": label, "percent": pct, "resets_at": reset.isoformat() if reset else None,
         "window_seconds": window_seconds, "pace": None}
    if reset and window_seconds:
        left = max(0.0, (reset - now).total_seconds())
        elapsed = min(1.0, max(0.0, 1 - left / window_seconds))
        pace = {"elapsed_pct": round(elapsed * 100, 1), "projected_pct": None, "hits_limit_at": None}
        if elapsed >= 0.02:  # too early in the window to project anything meaningful
            pace["projected_pct"] = round(pct / elapsed, 1)
            used_s = elapsed * window_seconds
            if pct > 0 and pct < 100 and pct / elapsed > 100:
                hit = now + timedelta(seconds=(100 - pct) * used_s / pct)
                pace["hits_limit_at"] = hit.isoformat()
        d["pace"] = pace
    return d


# ---------- providers: each returns {"limits": [...], "note": str} ----------

def get_json(url, headers, timeout=15):
    req = urllib.request.Request(url, headers={"Accept": "application/json", **headers})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def claude():
    creds = json.load(open(os.path.join(HOME, ".claude", ".credentials.json")))
    tok = creds["claudeAiOauth"]["accessToken"]
    d = get_json("https://api.anthropic.com/api/oauth/usage",
                 {"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"})
    kinds = {"session": ("5-hour session", 5 * HOUR), "weekly_all": ("Weekly (all models)", 7 * DAY),
             "weekly_scoped": ("Weekly (scoped)", 7 * DAY)}
    out = []
    for l in d.get("limits") or []:
        label, window = kinds.get(l["kind"], (l["kind"], 7 * DAY if l.get("group") == "weekly" else None))
        sc = l.get("scope")
        name = ((sc.get("model") or {}).get("display_name") if isinstance(sc, dict) else sc) if sc else None
        if name:
            label = label.replace("(scoped)", f"({name})")
        out.append(limit(label, l.get("percent"), l.get("resets_at"), window))
    if not out:  # older response shape
        for k, label, window in (("five_hour", "5-hour session", 5 * HOUR), ("seven_day", "Weekly", 7 * DAY)):
            if d.get(k):
                out.append(limit(label, d[k]["utilization"], d[k]["resets_at"], window))
    extra = d.get("extra_usage") or {}
    return {"limits": out, "note": f"Extra usage: {'on' if extra.get('is_enabled') else 'off'}" if extra else ""}


def find_codex():
    """Respect PATH, with portable fallbacks for apps launched outside a shell."""
    override = os.environ.get("CODEX_BIN")
    if override:
        exe = shutil.which(os.path.expanduser(override))
        if not exe:
            raise RuntimeError("CODEX_BIN does not point to an executable")
        return exe
    exe = shutil.which("codex")
    if exe:
        return exe
    # User installs, npm's configured prefix, and system/Homebrew installs.
    dirs = [os.path.join(HOME, p) for p in (".local/bin", "bin", ".npm-global/bin", ".npm/bin", ".cargo/bin")]
    if os.environ.get("NPM_CONFIG_PREFIX"):
        dirs.append(os.path.join(os.path.expanduser(os.environ["NPM_CONFIG_PREFIX"]), "bin"))
    dirs.extend(("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/home/linuxbrew/.linuxbrew/bin"))
    return shutil.which("codex", path=os.pathsep.join(dirs))


def codex():
    exe = find_codex()
    if not exe:
        raise RuntimeError("codex not found; add it to PATH or set CODEX_BIN to its executable path")
    msgs = [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"clientInfo": {"name": "token-status", "version": "1"}}},
        {"jsonrpc": "2.0", "method": "initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "account/rateLimits/read"},
    ]
    p = subprocess.Popen([exe, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True)
    p.stdin.write("".join(json.dumps(m) + "\n" for m in msgs)); p.stdin.flush()
    result, deadline = None, time.time() + 30
    try:
        while time.time() < deadline:
            line = p.stdout.readline()
            if not line:
                break
            m = json.loads(line)
            if m.get("id") == 2:
                if "error" in m:
                    raise RuntimeError(m["error"].get("message", m["error"]))
                result = m["result"]; break
    finally:
        p.kill()
    if result is None:
        raise RuntimeError("no response from codex app-server")
    out = []
    for lid, rl in (result.get("rateLimitsByLimitId") or {"codex": result["rateLimits"]}).items():
        for slot in ("primary", "secondary"):
            w = rl.get(slot)
            if not w:
                continue
            mins = w.get("windowDurationMins") or 0
            win = "Weekly" if mins == 10080 else "5-hour" if mins == 300 else f"{mins // 60}h"
            name = rl.get("limitName") or ("" if lid == "codex" else lid)
            out.append(limit(f"{win} {name}".strip(), w.get("usedPercent"), w.get("resetsAt"), mins * 60 or None))
    rl = result["rateLimits"]
    resets = sum(1 for c in (result.get("rateLimitResetCredits") or {}).get("credits", []) if c.get("status") == "available")
    return {"limits": out, "note": f"Plan: {rl.get('planType')} · credits: {rl.get('credits', {}).get('balance')} · resets left: {resets}"}


GROK_HOME = os.environ.get("GROK_HOME", os.path.join(HOME, ".grok"))


def _grok_token():
    """auth.json maps '<issuer>::<client>' to OIDC sessions; use the one expiring last."""
    best = None
    for v in json.load(open(os.path.join(GROK_HOME, "auth.json"))).values():
        if isinstance(v, dict) and v.get("key"):
            exp = v.get("expires_at") or ""
            if best is None or exp > best[1]:
                best = (v["key"], exp)
    if best is None:
        raise RuntimeError("not signed in to grok")
    return best[0], to_dt(best[1]) if best[1] else None


def _grok_refresh():
    """`grok models` signs in with the stored refresh token (no model call) and rewrites auth.json."""
    exe = os.path.join(GROK_HOME, "bin", "grok")
    exe = exe if os.path.exists(exe) else shutil.which("grok")
    if exe:
        subprocess.run([exe, "models"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=30)


def grok():
    tok, exp = _grok_token()
    if exp and exp <= datetime.now(timezone.utc):
        _grok_refresh(); tok, _ = _grok_token()
    url = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
    try:
        d = get_json(url, {"Authorization": f"Bearer {tok}"})
    except urllib.error.HTTPError as e:
        if e.code != 401:
            raise
        _grok_refresh(); tok, _ = _grok_token()
        d = get_json(url, {"Authorization": f"Bearer {tok}"})
    cfg = d.get("config") or {}
    period = cfg.get("currentPeriod") or {}
    kind = {"USAGE_PERIOD_TYPE_WEEKLY": "Weekly", "USAGE_PERIOD_TYPE_MONTHLY": "Monthly"}.get(period.get("type"), "Usage")
    start, end = to_dt(period.get("start")), to_dt(period.get("end"))
    window = (end - start).total_seconds() if start and end else None
    split = " · ".join(f"{p['product'].replace('Grok', '')} {p.get('usagePercent', 0):g}%" for p in cfg.get("productUsage") or [])
    return {"limits": [limit(kind, cfg.get("creditUsagePercent") or 0, period.get("end"), window)],  # proto3 omits 0
            "note": f"of which {split}" if split else ""}


PROVIDERS = {"claude": ("Claude", claude), "codex": ("Codex", codex), "grok": ("Grok", grok)}


def fetch(which):
    try:
        return {**PROVIDERS[which][1](), "error": None}
    except Exception as e:
        return {"limits": [], "note": "", "error": str(e)}


# ---------- rendering ----------

GRAY, RESET = "\033[90m", "\033[0m"


def bar(pct, elapsed=None, width=30):
    pct = max(0.0, min(100.0, pct))
    n = round(width * pct / 100)
    color = "\033[32m" if pct < 60 else "\033[33m" if pct < 85 else "\033[31m"
    cells = [f"{color}█" if i < n else f"{GRAY}░" for i in range(width)]
    if elapsed is not None:
        m = min(width - 1, int(width * elapsed / 100))
        cells[m] = f"{RESET}\033[1m│"
    return "".join(cells) + f"{RESET} {pct:5.1f}%"


def when(dt):
    secs = int((dt - datetime.now(timezone.utc)).total_seconds())
    if secs <= 0:
        return "now"
    d, r = divmod(secs, DAY); h, r = divmod(r, HOUR); m = r // 60
    rel = f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"
    return f"{rel} ({dt.astimezone().strftime('%a %H:%M')})"


def render(name, data):
    out = [f"\033[1m{name}{RESET}"]
    for l in data["limits"]:
        reset = to_dt(l["resets_at"])
        p = l["pace"] or {}
        out.append(f"  {l['label']}  {GRAY}↻ {when(reset) if reset else '?'}{RESET}")
        out.append(f"  {bar(l['percent'], p.get('elapsed_pct'))}")
        if p.get("hits_limit_at"):
            out.append(f"  \033[31m▲ at this pace, limit in {when(to_dt(p['hits_limit_at']))}{RESET}")
        elif p.get("projected_pct") is not None:
            tone = "\033[32m" if p["projected_pct"] <= 85 else "\033[33m"
            out.append(f"  {tone}on pace for ~{p['projected_pct']:.0f}% by reset{RESET}")
    if data["note"]:
        out.append(f"  {GRAY}{data['note']}{RESET}")
    if data["error"]:
        out.append(f"  \033[31merror: {data['error']}{RESET}")
    return out


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    which = args[0] if args else "all"
    if which not in (*PROVIDERS, "all"):
        sys.exit(__doc__)
    names = list(PROVIDERS) if which == "all" else [which]
    if as_json:
        print(json.dumps({"fetched_at": datetime.now(timezone.utc).isoformat(),
                          **{w: fetch(w) for w in names}}, indent=2))
        return
    interval = int(args[1]) if len(args) > 1 else DEFAULT_INTERVAL[which]
    mtime = os.path.getmtime(__file__)
    while True:
        out = [f"\033[1mUsage{RESET}  {GRAY}{datetime.now().strftime('%H:%M:%S')} · every {interval}s · │ = time elapsed{RESET}", ""]
        for w in names:
            out += render(PROVIDERS[w][0], fetch(w)) + [""]
        sys.stdout.write("\033[H\033[2J" + "\n".join(out)); sys.stdout.flush()
        end = time.time() + interval
        while time.time() < end:
            time.sleep(2)
            if os.path.getmtime(__file__) != mtime:  # script edited: restart with the new code
                os.execv(sys.executable, [sys.executable, __file__, *sys.argv[1:]])


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
